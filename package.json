{
  "name": "dokunc",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -n web,collab -c blue,magenta \"pnpm --filter @dokunc/web dev\" \"pnpm --filter @dokunc/collab dev\"",
    "build": "pnpm --filter @dokunc/db generate && pnpm --filter @dokunc/web build",
    "lint": "eslint .",
    "start": "concurrently --kill-others-on-fail -n web,collab -c blue,magenta \"pnpm --filter @dokunc/web start\" \"pnpm --filter @dokunc/collab start\"",
    "test": "pnpm --filter @dokunc/web test",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @dokunc/db migrate",
    "db:generate": "pnpm --filter @dokunc/db generate",
    "test:integration": "pnpm --filter @dokunc/web test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.4",
    "@playwright/test": "1.61.1",
    "@types/pg": "8.20.0",
    "concurrently": "10.0.3",
    "dotenv": "17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "pg": "8.22.0",
    "typescript-eslint": "^8.70.0"
  }
}
