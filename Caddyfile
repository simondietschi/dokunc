# Reverse-Proxy mit TLS-Terminierung.
# Standard: localhost mit Caddys interner CA (für internen/VPN-Betrieb).
# Für eine echte Domain wird diese Datei NICHT geändert, alles steht in
# der .env: SITE_ADDRESS=wiki.example.com, CADDY_TLS=<eigene Mailadresse>
# (Caddy holt dann Let's-Encrypt-Zertifikate), dazu APP_BIND, APP_PORT=443
# und COMPOSE_FILE (s. README), sonst bleibt die Instanz von aussen
# unerreichbar.
#
# Globale Optionen: die eigene CA nicht in den Zertifikatsspeicher des
# Containers eintragen. Dort nuetzt sie niemandem, und das Dateisystem des
# Proxys ist schreibgeschuetzt (read_only in docker-compose.yml). Ohne
# diese Zeile meldet Caddy bei jedem Start "failed to install root
# certificate". Browser vertrauen der CA so wenig wie vorher. (Keine
# Leerzeile vor dem Block: caddy fmt verlangt es so und warnt sonst bei
# jedem Start.)
#
# X-Forwarded-For: Caddy uebernimmt den Header nur von den Adressen in
# TRUSTED_PROXIES (vorgelagerter Load Balancer, WAF, CDN) und haengt die
# eigene Gegenstelle an. Von allen anderen verwirft er ihn und setzt die
# Gegenstelle (Caddys Vorgabe seit 2.5, geprueft mit 2.11). Passend dazu
# in der App: TRUSTED_PROXY_HOPS = 1 plus die Zahl der Proxys davor. Die
# Liste wird mit Leerzeichen getrennt; ein Komma haelt Caddy beim Start
# an (die App prueft das Format vorher und nennt den Fehler). Leer =
# niemand ist vertraut, wie bisher. trusted_proxies_strict: auch
# {client_ip} (Zugriffslog, Matcher) zaehlt von rechts; ohne nimmt Caddy
# dort den linken Eintrag, also einen, den der Client geschrieben hat.
{
	skip_install_trust
	servers {
		trusted_proxies static {$TRUSTED_PROXIES}
		trusted_proxies_strict
	}
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# X-Forwarded-For setzt Caddy hier nicht selbst (siehe globale
	# Optionen oben): ein header_up ersetzte auch den Header eines
	# vertrauten Proxys, und die Client-Adresse ginge verloren.

	# Collab-WebSocket: /collab -> interner Hocuspocus-Port 3001
	handle_path /collab* {
		reverse_proxy app:3001 {
			header_up Host {host}
		}
	}

	# Alles andere -> Next.js
	handle {
		reverse_proxy app:3000 {
			header_up Host {host}
		}
	}

	# internal = Caddys eigene CA; eine Mailadresse schaltet ACME ein
	# (Let's Encrypt, ZeroSSL als Ausweich). Über die Umgebung statt von
	# Hand: wer diese versionierte Datei änderte, stiess bei jedem Update
	# auf Konflikte. Leer darf der Wert nicht sein, sonst bricht Caddy mit
	# "wrong argument count" ab; docker-compose.yml reicht deshalb
	# ${CADDY_TLS:-internal} durch.
	tls {$CADDY_TLS:internal}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
