# Postgres
DATABASE_URL="postgresql://dokunc:dokunc@localhost:5432/dokunc?schema=public"

# Redis (Hocuspocus presence / future BullMQ)
REDIS_URL="redis://localhost:6379"

# Auth — signiert Sessions und die Collab-Authentifizierung.
# Docker: leer lassen -> der Container erzeugt beim ersten Start ein
# zufälliges Secret und legt es dauerhaft im Volume app_data ab.
# Eigenes setzen (empfohlen ab mehreren Instanzen), min. 32 Zeichen:
#   openssl rand -base64 48
APP_SECRET=""
JWT_EXPIRES_IN="7d"

# Docker/Prod: Postgres-Passwort (auch in DATABASE_URL verwendet)
POSTGRES_PASSWORD="dokunc"

# Reverse-Proxy (Docker): Adresse für TLS. localhost = interne Caddy-CA.
# Für echte Domain: z. B. wiki.example.com
SITE_ADDRESS="localhost"
# Host-Port des Proxys (Docker). Die App ist dann unter
# https://localhost:<APP_PORT> erreichbar.
APP_PORT=7891

# URLs — lokale Entwicklung (ohne Docker/Proxy):
APP_URL="http://localhost:3000"
NEXT_PUBLIC_COLLAB_URL="ws://localhost:3001"
# Docker mit Proxy: APP_URL="https://localhost:7891" — NEXT_PUBLIC_COLLAB_URL
# bleibt dort leer, die App leitet wss://<host>/collab selbst ab.

# Collab-Server
COLLAB_PORT=3001

# Anzahl vertrauenswürdiger Reverse-Proxys vor der App. Die Ratenbegrenzung
# liest die Client-IP entsprechend viele Einträge von RECHTS aus
# X-Forwarded-For — der linke Teil ist vom Client fälschbar.
# Docker-Setup (nur Caddy): 1. Zusätzliches CDN/LB davor: 2.
TRUSTED_PROXY_HOPS=1

# E-Mail (Einladungen). Ohne SMTP_HOST wird der Einladungslink
# nur in die Server-Logs geschrieben (Dev-Fallback).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USERNAME=""
SMTP_PASSWORD=""
MAIL_FROM_ADDRESS="dokunc <no-reply@example.com>"

# Benachrichtigungs-Mails (Erwähnungen, Kommentar-Antworten). Der
# Collab-Prozess prüft alle MAIL_DISPATCH_INTERVAL_S Sekunden auf offene
# Einträge; die Tageszusammenfassung für "Täglich"-Nutzer wird ab
# DIGEST_HOUR_UTC (Stunde, UTC) einmal pro Tag verschickt.
MAIL_DISPATCH_INTERVAL_S=30
DIGEST_HOUR_UTC=6

# Uploads (Bilder und Anhaenge im Editor). Default: ./uploads im Web-Prozess.
UPLOAD_DIR=""
# Maximale Groesse einer hochgeladenen Datei in MB (Default: 50).
MAX_UPLOAD_MB=50

# Import (Markdown/Confluence/Notion): Upload-Limit pro Import in MB
# (alle Dateien zusammen). Default: 100
IMPORT_MAX_MB=100

# KI ("Frag dein Wiki" + Editor-Assistent). Ohne Key sind die
# KI-Features deaktiviert (mit Hinweis in der UI).
ANTHROPIC_API_KEY=""
# Modell für KI-Antworten (Default: claude-opus-4-8)
AI_MODEL=""
# Optional: semantische Suche via Voyage-Embeddings (sonst Volltext-Fallback)
VOYAGE_API_KEY=""
EMBEDDING_MODEL=""

# PDF-Export: URL eines Gotenberg-Dienstes (im Docker-Setup automatisch
# http://gotenberg:3000). Ohne Wert nutzt "Drucken / PDF" den Browser.
GOTENBERG_URL=""
