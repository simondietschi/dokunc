# Postgres
DATABASE_URL="postgresql://dokunc:dokunc@localhost:5432/dokunc?schema=public"

# Redis, u. a. fuer den Abgleich mehrerer Collab-Instanzen, das
# Wiederherstellen von Versionen, Bremsen (Rate-Limits), Sperren und
# Import-Plaetze.
REDIS_URL="redis://localhost:6379"

# Auth — signiert Sessions und die Collab-Authentifizierung.
# Docker: leer lassen -> der Container erzeugt beim ersten Start ein
# zufälliges Secret und legt es dauerhaft im Volume app_data ab.
# Eigenes setzen (empfohlen ab mehreren Instanzen), min. 32 Zeichen:
#   openssl rand -base64 48
# Nicht Teil von scripts/backup.sh. Wer es automatisch erzeugen laesst,
# sichert es getrennt ausserhalb des Repositorys (README "Sicherung und Rueckweg").
APP_SECRET=""
JWT_EXPIRES_IN="7d"
# Abmeldung nach Untätigkeit, im Format von JWT_EXPIRES_IN, z. B.
#   SESSION_IDLE_TIMEOUT="12h"
# Wer so lange nichts in der App getan hat, muss sich neu anmelden, auch
# wenn JWT_EXPIRES_IN noch nicht erreicht ist. Empfohlen für geteilte
# Geräte (Empfang, Schulungsraum): ohne Grenze bleibt ein liegen
# gelassenes oder abgegriffenes Sitzungs-Cookie bis zum Ende von
# JWT_EXPIRES_IN gültig. Werte unter 20 Minuten werden auf 20 Minuten
# angehoben, weil die letzte Aktivität nur auf zehn Minuten genau
# nachgeführt wird. Leer (Vorgabe), "0" oder "off" = keine Grenze.
SESSION_IDLE_TIMEOUT=""

# Docker/Prod: Postgres-Passwort (auch in DATABASE_URL verwendet)
POSTGRES_PASSWORD="dokunc"

# Reverse-Proxy (Docker): Adresse für TLS. localhost = interne Caddy-CA.
# Für echte Domain: z. B. wiki.example.com — dann APP_URL unten
# mitziehen, sonst lehnt die App Uploads als fremde Herkunft ab.
SITE_ADDRESS="localhost"
# Zertifikate des Proxys (Docker). internal = Caddys eigene CA (Browser
# warnt, für localhost und internen Betrieb). Für eine eigene Domain die
# eigene Mailadresse eintragen: Caddy holt dann Zertifikate bei Let's
# Encrypt und erneuert sie selbst. Leer zählt wie internal.
CADDY_TLS="internal"
# Host-Port des Proxys (Docker). Die App ist dann unter
# https://localhost:<APP_PORT> erreichbar.
APP_PORT=7891
# Adresse, auf der der Proxy (Docker) Verbindungen annimmt. Vorgabe
# 127.0.0.1: nur vom Server selbst aus erreichbar, kein LAN-Zugriff. Für
# eine eigene Domain 0.0.0.0 (alle IPv4-Adressen des Servers) und
# APP_PORT=443 setzen — APP_PORT allein genügt nicht, die Instanz bliebe
# von aussen unerreichbar. Leer zählt wie die Vorgabe. 0.0.0.0 bedient
# nur IPv4; für IPv6 s. APP_BIND6.
APP_BIND="127.0.0.1"
# IPv6-Adresse des Proxys (Docker), nur mit docker-compose.ipv6.yml in
# COMPOSE_FILE (s. u.). Vorgabe ::1, nur der Server selbst; "::" für alle
# IPv6-Adressen. Die Datei nur einbinden, wenn der Server IPv6 hat, sonst
# startet der Proxy nicht.
# APP_BIND6="::"
# Eigene Domain mit Let's Encrypt (Docker): veröffentlicht zusätzlich
# Port 80 auf APP_BIND, für den Zertifikatsnachweis und die Umleitung auf
# HTTPS (s. README und docker-compose.domain.yml). Dafür einkommentieren:
# COMPOSE_FILE=docker-compose.yml:docker-compose.domain.yml
# Mit IPv6 (APP_BIND6) stattdessen:
# COMPOSE_FILE=docker-compose.yml:docker-compose.domain.yml:docker-compose.ipv6.yml
# COMPOSE_FILE ersetzt die Standardliste: eine docker-compose.override.yml
# liest docker compose dann nicht mehr von selbst, ihre Anpassungen
# fielen still weg. Wer eine nutzt, hängt sie ans Ende der Liste
# (…:docker-compose.override.yml). Trenner unter Linux und macOS ":",
# unter Windows ";" (änderbar über COMPOSE_PATH_SEPARATOR).

# Anzeigename der Instanz. Erscheint als Aussteller in
# Authenticator-Apps (Zwei-Faktor-Anmeldung). Default: dokunc
APP_NAME="dokunc"

# URLs — lokale Entwicklung (ohne Docker/Proxy).
#
# WICHTIG: APP_URL muss denselben Namen tragen, unter dem die Instanz
# wirklich aufgerufen wird. Sie entscheidet allein, welche Herkunft die
# Route-Handler (Upload, Import, Collab-Ticket, KI) annehmen, und Next
# prueft Server Actions ohnehin schon genau dagegen. Wer SITE_ADDRESS auf
# eine echte Domain setzt und APP_URL vergisst, bekommt 403 statt Upload
# — im Log steht dann ein Satz, der beide Namen nennt.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_COLLAB_URL="ws://localhost:3001"
# Docker mit Proxy: APP_URL="https://localhost:7891" — NEXT_PUBLIC_COLLAB_URL
# bleibt dort leer, die App leitet wss://<host>/collab selbst ab.

# Collab-Server
COLLAB_PORT=3001

# Der Collab-Server prueft die Tickets mit demselben APP_SECRET wie die
# App. Ohne eigenes Secret (min. 32 Zeichen) startet er nur mit
# NODE_ENV=development, das `pnpm dev` fuer ihn setzt; `pnpm start`, die
# E2E-Tests und jeder andere Start brauchen APP_SECRET (Docker erzeugt es).

# Grenzen des Collab-Servers, je Instanz. Leer = Vorgabe, 0 = Grenze aus.
# Offene WebSockets der Instanz, angemeldet oder nicht (Vorgabe 1000). Ein
# Richtwert fuer den mitgelieferten Container, nicht das Dateideskriptor-
# Limit: Node hebt das weiche Limit beim Start auf das harte an. Nur wo
# das harte Limit selbst niedrig ist ("Max open files" in
# /proc/<pid>/limits), muss es fuer eine hoehere Grenze mit steigen.
COLLAB_MAX_CONNECTIONS=
# Offene WebSockets je Client-Adresse (Vorgabe 50). Hinter einem
# Firmen-NAT teilen sich viele Menschen eine Adresse: dort hoeher setzen.
COLLAB_MAX_CONNECTIONS_PER_IP=
# Gleichzeitige Verbindungen einer Person, eine je offenem Tab (Vorgabe 50).
COLLAB_MAX_CONNECTIONS_PER_USER=
# Verbindungsversuche je Adresse und Minute, vor dem Handshake (Vorgabe 300).
COLLAB_MAX_ATTEMPTS_PER_IP=
# Verbindungsversuche je Person und Minute (Vorgabe 120, wie die Ticket-Route).
COLLAB_MAX_ATTEMPTS_PER_USER=
# Die Adresse liest der Collab-Server wie die App nach TRUSTED_PROXY_HOPS
# (unten). Ein Socket, der sich nicht binnen 15 s mit gueltigem Ticket
# anmeldet, wird geschlossen (fest).

# Groessengrenzen des Collab-Servers (leer = Vorgabe, 0 = aus). Alle
# Instanzen brauchen dieselben Werte. Ganze Zahlen; ein ungueltiger Wert
# (etwa "1.5" oder "-1") gilt als leer, das Log meldet ihn beim Start.
# Groesse des Bearbeitungsstands einer Seite in MB (Vorgabe 16, bei einem
# Container mit 1 GB eher 8). Ab der Haelfte warnen Log und Editor,
# darueber kann die Seite nur noch gelesen werden, bis sie wieder kleiner
# ist (Version wiederherstellen) oder die Grenze steigt. Die groessten
# Seiten zeigt /admin/documents, beim Start nennt das Log die Zahl der
# Seiten ueber der Grenze.
COLLAB_MAX_DOC_MB=
# Groesste WebSocket-Nachricht in MB (Vorgabe: COLLAB_MAX_DOC_MB plus 1,
# ohne Dokumentgrenze 100). Mindestens COLLAB_MAX_DOC_MB plus 1 setzen,
# sonst warnt der Server beim Start: ein Browser, der eine Seite ganz neu
# abgleicht, schickt sie in einer Nachricht, und eine Seite kann die
# Dokumentgrenze um eine Aenderung ueberschreiten, bevor die Sperre
# greift. Groessere Nachrichten schliesst der Server (Code 1009), der
# Editor zeigt dann "Änderung zu gross". 0 = keine Grenze (nicht
# empfohlen).
COLLAB_MAX_MESSAGE_MB=

# Anzahl eigener Reverse-Proxys vor der App. Daraus lesen die App und der
# Collab-Server, welchem Eintrag in X-Forwarded-For sie glauben duerfen:
# gezaehlt wird von RECHTS, denn der linke Teil des Headers ist vom Client
# frei faelschbar und die Rate-Limits waeren sonst wirkungslos.
#   1 = Standard-Setup mit Caddy (docker-compose)
#   0 = App haengt direkt am Netz: X-Forwarded-For wird ignoriert
#   2 = zusaetzlich ein CDN oder ein weiterer Proxy davor
TRUSTED_PROXY_HOPS=1

# Single Sign-on (OIDC). Ohne OIDC_ISSUER und OIDC_CLIENT_ID bleibt die
# Anmeldung rein lokal; die Anmeldung mit Passwort funktioniert immer,
# damit ein Ausfall des Anbieters niemanden aussperrt.
#
# Beim Anbieter als Rueckgabeadresse eintragen:
#   <APP_URL>/api/auth/oidc/callback
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
# Leer lassen fuer einen oeffentlichen Client; PKCE traegt dann die
# Beweislast.
OIDC_CLIENT_SECRET=""
OIDC_SCOPES="openid email profile"
OIDC_BUTTON_LABEL="Single Sign-on"
# true = der Anbieter darf neue Konten anlegen. Standard false: dann
# meldet sich nur an, wer hier schon ein Konto hat (Invite-only bleibt
# damit auch fuer SSO gueltig). Das allererste Konto entsteht immer.
OIDC_ALLOW_SIGNUP="false"
# Verknuepft der Anbieter ein bestehendes Konto ueber die E-Mail-Adresse?
# Standard true, verlangt aber immer email_verified vom Anbieter. Auf
# false stellen, wenn im Verzeichnis Adressen neu vergeben werden
# koennen: dann uebernimmt sonst die neue Inhaberin das alte Konto.
# Konten mit Verwaltungsrechten werden nie automatisch verknuepft.
OIDC_AUTO_LINK_BY_EMAIL="true"

# E-Mail (Einladungen, Passwort-Reset). Ohne SMTP_HOST steht der Link nur
# ausserhalb der Produktion im Server-Log (Dev-Fallback). Mit
# NODE_ENV=production, also auch im Docker-Container, kommt er nirgends an.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USERNAME=""
SMTP_PASSWORD=""
MAIL_FROM_ADDRESS="dokunc <no-reply@example.com>"

# Benachrichtigungs-Mails (Erwähnungen, Kommentar-Antworten). Der
# Collab-Prozess prüft alle MAIL_DISPATCH_INTERVAL_S Sekunden auf offene
# Einträge; die Tageszusammenfassung für "Täglich"-Nutzer wird ab
# DIGEST_HOUR_UTC (Stunde, UTC) einmal pro Tag verschickt.
MAIL_DISPATCH_INTERVAL_S=30
DIGEST_HOUR_UTC=6

# Uploads (Bilder und Anhaenge im Editor). Default: ./uploads im Web-Prozess.
UPLOAD_DIR=""
# Maximale Groesse einer hochgeladenen Datei in MB (Default: 50).
MAX_UPLOAD_MB=50
# Aufraeumer fuer verwaiste Uploads: entfernt im Web-Prozess Dateien aus dem
# Upload-Verzeichnis, die keinen Datensatz mehr haben, aelter als 24 h sind
# und nirgends mehr verwendet werden (Seiteninhalt, auch im Papierkorb und in
# Vorlagen, Titelbild, Versionen, Collab-Zustand, Kommentare,
# Space-Beschreibung). Abstand der Laeufe in Stunden: 1 bis 168, Default 6;
# Werte ueber 0 und unter 1 werden auf 1 angehoben, groessere als 168 auf
# 168 gekappt, negative oder unlesbare gelten als 6 (jeweils mit Warnung
# im Log). 0 schaltet ihn ab. Erster Lauf 10 Minuten nach dem Start.
UPLOAD_SWEEP_INTERVAL_H=6

# Aufbewahrung: ein taeglicher Job im Web-Prozess loescht alte Datensaetze
# in Stapeln (erster Lauf 15 Minuten nach dem Start, mit Redis je Tag eine
# Instanz). Tage als ganze Zahl, 0 = unbegrenzt aufbewahren. Unlesbare Werte
# gelten als Vorgabe, Werte ueber 36500 werden gekappt (jeweils mit Warnung
# im Log). Der erste Lauf nach dem Update wendet die Fristen auf den ganzen
# Bestand an: vorher eine Sicherung ziehen.
# Abgelaufene oder widerrufene Sitzungen, Tage nach Ablauf bzw. Widerruf.
SESSION_RETENTION_DAYS=30
# Passwort-Reset-Links und Einladungen, Tage nach Ablauf, Einloesung oder Annahme.
TOKEN_RETENTION_DAYS=30
# Gelesene Benachrichtigungen, Tage nach dem Lesen (ungelesene bleiben).
NOTIFICATION_RETENTION_DAYS=90
# Audit-Log, Tage nach dem Ereignis. 0 behaelt alles.
AUDIT_RETENTION_DAYS=365
# Papierkorb: Seiten so viele Tage nach dem Loeschen endgueltig entfernen.
# Default 0: nie automatisch.
TRASH_RETENTION_DAYS=0
# Versionen ausduennen: aus den letzten 24 Stunden bleibt jede, bis 30 Tage
# die letzte je Stunde, danach die letzte je Tag (UTC). Die erste Version
# einer Seite und wiederhergestellte Staende bleiben immer. standard oder
# off (unlesbare Werte gelten als standard, mit Warnung im Log).
VERSION_RETENTION=standard

# Import (Markdown/Confluence/Notion): Upload-Limit pro Import in MB
# (alle Dateien zusammen). Default: 100
IMPORT_MAX_MB=100
# Wie viele Importe gleichzeitig laufen duerfen, ueber alle Konten (mit
# Redis ueber alle Web-Instanzen). Je Konto laeuft ausserdem hoechstens ein
# Import. Weitere Anfragen bekommen 429. Ganze Zahl ab 1. Default: 2
IMPORT_MAX_CONCURRENT=2
# Zeitgrenze eines Imports in Sekunden, gezaehlt ab dem fertig gelesenen
# Upload. Laeuft sie ab, wird alles schon Angelegte zurueckgenommen.
# Erlaubt 1 bis 3600; Werte ausserhalb werden gekappt, 0, negative oder
# unlesbare (auch Infinity) gelten als 80, jeweils mit Warnung im Log.
# Default: 80. Auf Plattformen, die maxDuration durchsetzen, nicht ueber 80.
IMPORT_TIMEOUT_S=80

# KI ("Frag dein Wiki" + Editor-Assistent). Ohne Key sind die
# KI-Features deaktiviert (mit Hinweis in der UI).
ANTHROPIC_API_KEY=""
# Modell für KI-Antworten (Default: claude-opus-4-8)
AI_MODEL=""
# Optional: semantische Suche via Voyage-Embeddings (sonst Volltext-Fallback).
# Eingebettet wird nur, wenn auch ANTHROPIC_API_KEY gesetzt ist. Dann geht
# der Text aller Seiten (ausser Papierkorb und Vorlagen, auch geschuetzte)
# an Voyage AI.
VOYAGE_API_KEY=""
# Modell der Embeddings (Default: voyage-3.5-lite). Nach einem Wechsel
# bettet der KI-Index den ganzen Bestand im Hintergrund neu ein; bis dahin
# mischt "Frag dein Wiki" Volltexttreffer bei. Ausnahme beim Update auf die
# Version mit dem KI-Index: Embeddings von davor ordnet der erste Lauf dem
# dann eingestellten Modell zu. Das Modell deshalb erst nach diesem Update
# wechseln (siehe README, Abschnitt KI-Index).
EMBEDDING_MODEL=""
# KI-Index (Collab-Prozess): zerlegt neue und geaenderte Seiten, auch aus
# Import und Vorlagen, in Abschnitte und bettet sie ein. Abstand der Laeufe
# in Sekunden, erlaubt 10 bis 3600. 0 schaltet den KI-Index ab: neue Seiten
# aus Import und Vorlagen bekommen dann erst beim Bearbeiten Abschnitte, und
# kein Seitentext wird mehr eingebettet. Frag dein Wiki nutzt vorhandene
# Embeddings weiter und schickt jede Frage an Voyage, solange VOYAGE_API_KEY
# gesetzt ist; ganz ohne Voyage: VOYAGE_API_KEY leeren.
# Werte ausserhalb werden gekappt, unlesbare gelten als 60 (jeweils mit
# Warnung im Log). Default: 60
AI_INDEX_INTERVAL_S=60
# Abschnitte je Anfrage an Voyage, erlaubt 1 bis 256, Default 64. Bei
# knappem Kontingent kleiner setzen; ein Lauf sendet hoechstens 20 Anfragen.
# 0 und unlesbare Werte gelten als 64, groessere werden auf 256 gekappt
# (jeweils mit Warnung im Log). Voyage begrenzt ausserdem die Tokens je
# Anfrage: 256 passt fuer voyage-3.5-lite (1 Mio. Tokens). Modelle mit
# tieferer Grenze (laut Voyage voyage-3.5 320 000, voyage-3-large und
# voyage-code-3 120 000) bei Text mit vielen Tokens je Zeichen (etwa
# Chinesisch, Japanisch) bei 64 lassen. Lehnt Voyage einen Stapel als zu
# gross ab (Log "voyage embeddings fehlgeschlagen" mit status 400 oder 413),
# kommt der KI-Index erst mit kleinerem Wert weiter.
AI_INDEX_EMBED_BATCH=64

# Protokolltiefe beider Prozesse (pino): trace, debug, info, warn, error,
# fatal. Vorgabe info.
LOG_LEVEL="info"
# Gesetzt = Prisma protokolliert jede Abfrage. Nur zur Fehlersuche in der
# Entwicklung: das Protokoll enthaelt Abfrageparameter.
DEBUG_DB=""

# PDF-Export: URL eines Gotenberg-Dienstes (im Docker-Setup automatisch
# http://gotenberg:3000). Ohne Wert nutzt "Drucken / PDF" den Browser.
GOTENBERG_URL=""
