# Postgres
DATABASE_URL="postgresql://dokunc:dokunc@localhost:5432/dokunc?schema=public"

# Redis (Hocuspocus presence / future BullMQ)
REDIS_URL="redis://localhost:6379"

# Auth — PFLICHT in Produktion, min. 32 Zeichen, zufällig erzeugen:
#   openssl rand -base64 48
APP_SECRET="change-me-please-change-me-please-32+"
JWT_EXPIRES_IN="7d"

# Docker/Prod: Postgres-Passwort (auch in DATABASE_URL verwendet)
POSTGRES_PASSWORD="dokunc"

# Reverse-Proxy (Docker): Adresse für TLS. localhost = interne Caddy-CA.
# Für echte Domain: z. B. wiki.example.com
SITE_ADDRESS="localhost"

# Anzeigename der Instanz. Erscheint als Aussteller in
# Authenticator-Apps (Zwei-Faktor-Anmeldung). Default: dokunc
APP_NAME="dokunc"

# URLs — lokale Entwicklung (ohne Docker/Proxy):
APP_URL="http://localhost:3000"
NEXT_PUBLIC_COLLAB_URL="ws://localhost:3001"
# Docker mit Proxy: APP_URL="https://localhost"
#                    NEXT_PUBLIC_COLLAB_URL="wss://localhost/collab"

# Collab-Server
COLLAB_PORT=3001

# Anzahl eigener Reverse-Proxys vor der App. Daraus liest die App, welchem
# Eintrag in X-Forwarded-For sie glauben darf — der Header ist sonst frei
# faelschbar und die Rate-Limits damit wirkungslos.
#   1 = Standard-Setup mit Caddy (docker-compose)
#   0 = App haengt direkt am Netz: X-Forwarded-For wird ignoriert
#   2 = zusaetzlich ein CDN oder ein weiterer Proxy davor
TRUSTED_PROXY_HOPS=1

# Single Sign-on (OIDC). Ohne OIDC_ISSUER und OIDC_CLIENT_ID bleibt die
# Anmeldung rein lokal; die Anmeldung mit Passwort funktioniert immer,
# damit ein Ausfall des Anbieters niemanden aussperrt.
#
# Beim Anbieter als Rueckgabeadresse eintragen:
#   <APP_URL>/api/auth/oidc/callback
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
# Leer lassen fuer einen oeffentlichen Client; PKCE traegt dann die
# Beweislast.
OIDC_CLIENT_SECRET=""
OIDC_SCOPES="openid email profile"
OIDC_BUTTON_LABEL="Single Sign-on"
# true = der Anbieter darf neue Konten anlegen. Standard false: dann
# meldet sich nur an, wer hier schon ein Konto hat (Invite-only bleibt
# damit auch fuer SSO gueltig). Das allererste Konto entsteht immer.
OIDC_ALLOW_SIGNUP="false"
# Verknuepft der Anbieter ein bestehendes Konto ueber die E-Mail-Adresse?
# Standard true, verlangt aber immer email_verified vom Anbieter. Auf
# false stellen, wenn im Verzeichnis Adressen neu vergeben werden
# koennen: dann uebernimmt sonst die neue Inhaberin das alte Konto.
# Konten mit Verwaltungsrechten werden nie automatisch verknuepft.
OIDC_AUTO_LINK_BY_EMAIL="true"

# E-Mail (Einladungen). Ohne SMTP_HOST wird der Einladungslink
# nur in die Server-Logs geschrieben (Dev-Fallback).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USERNAME=""
SMTP_PASSWORD=""
MAIL_FROM_ADDRESS="dokunc <no-reply@example.com>"

# Bild-Uploads (Editor). Default: ./uploads im Web-Prozess.
UPLOAD_DIR=""

# KI ("Frag dein Wiki" + Editor-Assistent). Ohne Key sind die
# KI-Features deaktiviert (mit Hinweis in der UI).
ANTHROPIC_API_KEY=""
# Modell für KI-Antworten (Default: claude-opus-4-8)
AI_MODEL=""
# Optional: semantische Suche via Voyage-Embeddings (sonst Volltext-Fallback)
VOYAGE_API_KEY=""
EMBEDDING_MODEL=""

# PDF-Export: URL eines Gotenberg-Dienstes (im Docker-Setup automatisch
# http://gotenberg:3000). Ohne Wert nutzt "Drucken / PDF" den Browser.
GOTENBERG_URL=""
