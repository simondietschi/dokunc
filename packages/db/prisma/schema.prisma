generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum SpaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// Wie Benachrichtigungen zusätzlich per Mail zugestellt werden.
enum EmailNotificationMode {
  INSTANT
  DAILY
  OFF
}

enum SpaceVisibility {
  /// Nur mit Einladung sichtbar und betretbar.
  PRIVATE
  /// Fuer alle angemeldeten Personen auffindbar und beitretbar.
  OPEN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  /// Instanz-Admin (die erste registrierte Person).
  isAdmin      Boolean  @default(false)
  /// Deaktivierte Konten können sich nicht anmelden.
  isActive     Boolean  @default(true)
  /// Wird bei "überall abmelden" / Passwortwechsel erhöht -> alte JWTs ungültig.
  tokenVersion Int      @default(0)
  /// Mail-Zustellung von Benachrichtigungen: sofort, täglicher Digest oder aus.
  emailNotifications EmailNotificationMode @default(INSTANT)
  /// Verknuepfung mit einem OIDC-Anbieter. Gebunden wird an den
  /// Subject-Claim und nicht an die E-Mail: Adressen koennen im
  /// Verzeichnis neu vergeben werden, das Subject nicht.
  oidcSubject  String?
  oidcIssuer   String?
  /// TOTP-Geheimnis, verschluesselt (siehe lib/secret-box).
  totpSecret     String?
  /// Gesetzt, sobald die Einrichtung mit einem gueltigen Code bestaetigt wurde.
  totpEnabledAt  DateTime?
  /// Zuletzt akzeptierter TOTP-Zeitschritt. Verhindert, dass derselbe
  /// Code innerhalb seines Fensters ein zweites Mal gilt (RFC 6238, 5.2).
  totpLastStep   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   SpaceMember[]
  favorites     Favorite[]
  visits        PageVisit[]
  attachments   Attachment[]
  editedPages   Page[]         @relation("PageLastEditor")
  pageVersions  PageVersion[]
  passwordResets PasswordResetToken[]
  comments      Comment[]
  notifications Notification[] @relation("NotificationUser")
  actedNotifications Notification[] @relation("NotificationActor")
  auditEvents   AuditLog[]     @relation("AuditActor")
  sessions      Session[]
  pageSubscriptions PageSubscription[]
  recoveryCodes TotpRecoveryCode[]
  groupMemberships GroupMember[]
  pageGrants    PageGrant[]

  /// Das Subject ist nur beim jeweiligen Aussteller eindeutig. Wechselt
  /// eine Instanz den Anbieter, koennte eine gleich benannte Kennung
  /// beim neuen Anbieter sonst ein altes Konto uebernehmen.
  @@unique([oidcIssuer, oidcSubject])
}

/// Angemeldetes Geraet. Das JWT im Cookie traegt die Session-ID; damit
/// laesst sich eine einzelne Anmeldung beenden, ohne alle anderen
/// mitzureissen (dafuer gibt es weiterhin tokenVersion).
model Session {
  id         String    @id @default(cuid())
  userId     String
  /// Roher User-Agent, nur zur Wiedererkennung in der Uebersicht.
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  /// Grob nachgefuehrt (hoechstens alle paar Minuten), nicht pro Anfrage.
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

/// Tokenbasierter Passwort-Reset (nur SHA-256-Hash gespeichert).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Space {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String?
  /// Emoji-Icon des Space (optional).
  icon        String?
  visibility  SpaceVisibility @default(PRIVATE)
  /// Rolle, die ein Beitritt ueber die Space-Uebersicht vergibt.
  joinRole    SpaceRole       @default(MEMBER)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  members SpaceMember[]
  groups  SpaceGroup[]
  pages   Page[]
  invitations SpaceInvitation[]
  attachments Attachment[]
  auditEvents AuditLog[]
}

model SpaceMember {
  id      String    @id @default(cuid())
  userId  String
  spaceId String
  role    SpaceRole @default(MEMBER)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@index([spaceId])
}

/// Benannte Personengruppe, instanzweit verwaltet (Admin-Bereich).
/// Eine Gruppe kann einem Space mit einer Rolle zugeordnet werden und
/// auf einer geschuetzten Seite Zugriff erhalten.
model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members GroupMember[]
  spaces  SpaceGroup[]
  grants  PageGrant[]
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

/// Gruppe im Space. Die wirksame Rolle einer Person ist die staerkste
/// aus eigener Mitgliedschaft und allen Gruppen (siehe lib/space-access).
/// OWNER wird hier bewusst nicht vergeben: Eigentuemerschaft bleibt
/// persoenlich, sonst haengt der letzte Eigentuemer an einer Gruppenliste.
model SpaceGroup {
  id      String    @id @default(cuid())
  spaceId String
  groupId String
  role    SpaceRole @default(MEMBER)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([spaceId, groupId])
  @@index([groupId])
}

/// Zugriffseintrag einer geschuetzten Seite: entweder eine Person oder
/// eine Gruppe. Genau eines der beiden Felder ist gesetzt.
model PageGrant {
  id      String  @id @default(cuid())
  pageId  String
  userId  String?
  groupId String?

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@unique([pageId, groupId])
  @@index([pageId])
}

model Page {
  id          String   @id @default(cuid())
  spaceId     String
  parentId    String?
  title       String   @default("Untitled")
  /// Emoji vor dem Titel (Seitenbaum, Suche, Palette).
  icon        String?
  /// Titelbild ueber der Seite (URL aus /api/files).
  coverUrl    String?
  /// Vorlage: erscheint nicht im Seitenbaum, sondern unter "Vorlagen".
  isTemplate  Boolean  @default(false)
  /// TipTap/ProseMirror JSON
  content     Json?
  /// Flacher Text für Suche & History
  textContent String   @default("")
  position    Int      @default(0)
  /// Geschuetzt: nur Eingetragene (plus Space-Verwaltung) sehen sie.
  /// Der Schutz vererbt sich auf alle Unterseiten.
  isRestricted Boolean @default(false)
  /// Naechste geschuetzte Seite auf dem Weg zur Wurzel, sich selbst
  /// eingeschlossen; null = offen. Materialisiert, weil sonst jede
  /// Sichtbarkeitspruefung den Baum hochlaufen muesste.
  accessRootId String?
  /// Soft-Delete: gesetzt = im Papierkorb (nicht hart gelöscht).
  deletedAt   DateTime?
  /// Letzte bearbeitende Person (vom Collab-Server gesetzt).
  lastEditedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  space    Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  lastEditedBy User?      @relation("PageLastEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  parent   Page?          @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Page[]         @relation("PageTree")
  accessRoot     Page?     @relation("PageAccessRoot", fields: [accessRootId], references: [id], onDelete: SetNull)
  accessChildren Page[]    @relation("PageAccessRoot")
  grants         PageGrant[]
  versions PageVersion[]
  collab   CollabDocument?
  outgoingLinks PageLink[] @relation("LinkSource")
  incomingLinks PageLink[] @relation("LinkTarget")
  comments      Comment[]
  chunks        PageChunk[]
  subscriptions PageSubscription[]
  favorites     Favorite[]
  visits        PageVisit[]
  attachments   Attachment[]
  shares        PageShare[]

  @@index([spaceId])
  @@index([parentId])
  @@index([spaceId, isTemplate])
  @@index([accessRootId])
}

/// Bilder werden inline ausgeliefert, alles andere als Download.
enum AttachmentKind {
  IMAGE
  FILE
}

/// Hochgeladene Datei (Bild oder beliebiger Anhang) mit Space- und
/// optionalem Seitenbezug.
/// storedName = zufälliger Dateiname auf der Platte; name = Originalname.
/// Der Seitenbezug ist die Grundlage dafuer, dass Anhaenge geschuetzter
/// Seiten nicht an Unberechtigte ausgeliefert werden (siehe /api/files).
model Attachment {
  id         String   @id @default(cuid())
  spaceId    String
  pageId     String?
  uploaderId String?
  storedName String   @unique
  name       String
  mimeType   String
  kind       AttachmentKind @default(IMAGE)
  size       Int
  createdAt  DateTime @default(now())

  space    Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  page     Page? @relation(fields: [pageId], references: [id], onDelete: SetNull)
  uploader User? @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([spaceId])
  @@index([pageId])
  @@index([uploaderId])
}

/// Favorit (Lesezeichen) einer Person auf eine Seite.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  pageId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([userId, pageId])
  @@index([pageId])
  @@index([userId, createdAt])
}

/// Letzter Besuch einer Seite durch eine Person ("Zuletzt besucht").
/// Die eigene id traegt das Aufraeumen: pro Person bleiben nur die
/// juengsten Eintraege stehen (siehe lib/page-visits).
model PageVisit {
  id        String   @id @default(cuid())
  userId    String
  pageId    String
  visitedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([userId, pageId])
  @@index([userId, visitedAt])
}

/// Eine Person folgt einer Seite und bekommt Benachrichtigungen zu ihr.
model PageSubscription {
  id        String   @id @default(cuid())
  userId    String
  pageId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([userId, pageId])
  @@index([pageId])
}

/// Freigabelink auf eine Seite: lesen ohne Konto.
/// Gespeichert wird nur der SHA-256-Hash des Tokens, wie bei Einladungen.
model PageShare {
  id            String    @id @default(cuid())
  pageId        String
  tokenHash     String    @unique
  createdById   String?
  /// Untergeordnete Seiten mitfreigeben.
  includeChildren Boolean @default(false)
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

/// Wiki-Link zwischen zwei Seiten ([[Seite]]) — Basis für Backlinks.
/// Wird vom Collab-Server aus dem Dokumentinhalt extrahiert.
model PageLink {
  id           String @id @default(cuid())
  sourcePageId String
  targetPageId String

  source Page @relation("LinkSource", fields: [sourcePageId], references: [id], onDelete: Cascade)
  target Page @relation("LinkTarget", fields: [targetPageId], references: [id], onDelete: Cascade)

  @@unique([sourcePageId, targetPageId])
  @@index([targetPageId])
}

/// Kommentar-Thread auf einer Seite. parentId = Antwort im Thread.
/// anchorText = Textstelle, auf die sich der Thread bezieht (Snapshot);
/// die Markierung im Dokument trägt die Thread-ID als commentMark.
model Comment {
  id         String    @id @default(cuid())
  pageId     String
  parentId   String?
  authorId   String?
  body       String
  anchorText String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  page    Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("Thread")
  author  User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([parentId])
}

enum NotificationType {
  MENTION
  COMMENT
  COMMENT_REPLY
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  pageId    String?
  commentId String?
  readAt    DateTime?
  /// Gesetzt, sobald die Benachrichtigung per Mail zugestellt (oder
  /// bewusst übersprungen) wurde. NULL = noch offen für den Dispatcher.
  emailedAt DateTime?
  createdAt DateTime         @default(now())

  user  User  @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([emailedAt, createdAt])
}

/// Text-Chunk einer Seite für die KI-Suche ("Frag dein Wiki").
/// embedding: Float32-Vektor (Bytes) — optional, nur mit Embedding-Key.
model PageChunk {
  id         String   @id @default(cuid())
  pageId     String
  chunkIndex Int
  text       String
  embedding  Bytes?
  updatedAt  DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, chunkIndex])
  @@index([pageId])
}

model PageVersion {
  id          String   @id @default(cuid())
  pageId      String
  title       String
  content     Json?
  textContent String   @default("")
  authorId    String?
  createdAt   DateTime @default(now())

  page   Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([pageId])
}

/// Tokenbasierte E-Mail-Einladung in einen Space.
/// Sicherheit: es wird nur der SHA-256-Hash des Tokens gespeichert,
/// nie das Token selbst (analog zu Passwort-Reset-Tokens).
model SpaceInvitation {
  id          String    @id @default(cuid())
  spaceId     String
  email       String
  role        SpaceRole @default(MEMBER)
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  /// Höchstens eine offene Einladung pro E-Mail/Space.
  @@unique([spaceId, email])
  @@index([spaceId])
}

/// Sicherheitsrelevantes Ereignis (Anmeldung, Rollenwechsel, Loeschung).
model AuditLog {
  id        String   @id @default(cuid())
  /// Handelnde Person. Null, wenn unbekannt (fehlgeschlagene Anmeldung).
  actorId   String?
  /// Stabiler Ereignisschluessel, z. B. "member.role_changed".
  action    String
  spaceId   String?
  /// Kennung des betroffenen Objekts (Seite, Nutzer, Einladung).
  targetId  String?
  /// Zusatzkontext (alte und neue Rolle, Titel, Grund).
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  actor User?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  space Space? @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([spaceId, createdAt])
  @@index([actorId, createdAt])
}

/// Wiederherstellungscode fuer die Zwei-Faktor-Anmeldung.
/// Gespeichert wird nur der SHA-256-Hash, wie bei Einladungen.
model TotpRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
}

/// Von Hocuspocus verwalteter Yjs-Dokumentstatus
model CollabDocument {
  pageId    String   @id
  state     Bytes
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}
