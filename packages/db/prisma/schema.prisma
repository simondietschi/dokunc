generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum SpaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  /// Instanz-Admin (die erste registrierte Person).
  isAdmin      Boolean  @default(false)
  /// Deaktivierte Konten können sich nicht anmelden.
  isActive     Boolean  @default(true)
  /// Wird bei "überall abmelden" / Passwortwechsel erhöht -> alte JWTs ungültig.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   SpaceMember[]
  pageVersions  PageVersion[]
  passwordResets PasswordResetToken[]
  comments      Comment[]
  notifications Notification[] @relation("NotificationUser")
  actedNotifications Notification[] @relation("NotificationActor")
  pageTemplates PageTemplate[]
}

/// Tokenbasierter Passwort-Reset (nur SHA-256-Hash gespeichert).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Space {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members SpaceMember[]
  pages   Page[]
  invitations SpaceInvitation[]
  templates PageTemplate[]
}

model SpaceMember {
  id      String    @id @default(cuid())
  userId  String
  spaceId String
  role    SpaceRole @default(MEMBER)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@index([spaceId])
}

model Page {
  id          String   @id @default(cuid())
  spaceId     String
  parentId    String?
  title       String   @default("Untitled")
  /// Emoji/Symbol vor dem Titel (Sidebar, Wiki-Links, Suche).
  icon        String?
  /// Titelbild: Upload-URL (/api/files/…) oder Verlaufs-Preset (gradient:N).
  cover       String?
  /// TipTap/ProseMirror JSON
  content     Json?
  /// Flacher Text für Suche & History
  textContent String   @default("")
  position    Int      @default(0)
  /// Soft-Delete: gesetzt = im Papierkorb (nicht hart gelöscht).
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  space    Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parent   Page?          @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Page[]         @relation("PageTree")
  versions PageVersion[]
  collab   CollabDocument?
  outgoingLinks PageLink[] @relation("LinkSource")
  incomingLinks PageLink[] @relation("LinkTarget")
  comments      Comment[]
  chunks        PageChunk[]

  @@index([spaceId])
  @@index([parentId])
}

/// Wiki-Link zwischen zwei Seiten ([[Seite]]) — Basis für Backlinks.
/// Wird vom Collab-Server aus dem Dokumentinhalt extrahiert.
model PageLink {
  id           String @id @default(cuid())
  sourcePageId String
  targetPageId String

  source Page @relation("LinkSource", fields: [sourcePageId], references: [id], onDelete: Cascade)
  target Page @relation("LinkTarget", fields: [targetPageId], references: [id], onDelete: Cascade)

  @@unique([sourcePageId, targetPageId])
  @@index([targetPageId])
}

/// Kommentar-Thread auf einer Seite. parentId = Antwort im Thread.
/// anchorText = Textstelle, auf die sich der Thread bezieht (Snapshot);
/// die Markierung im Dokument trägt die Thread-ID als commentMark.
model Comment {
  id         String    @id @default(cuid())
  pageId     String
  parentId   String?
  authorId   String?
  body       String
  anchorText String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  page    Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("Thread")
  author  User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([parentId])
}

enum NotificationType {
  MENTION
  COMMENT
  COMMENT_REPLY
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  pageId    String?
  commentId String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User  @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
}

/// Text-Chunk einer Seite für die KI-Suche ("Frag dein Wiki").
/// embedding: Float32-Vektor (Bytes) — optional, nur mit Embedding-Key.
model PageChunk {
  id         String   @id @default(cuid())
  pageId     String
  chunkIndex Int
  text       String
  embedding  Bytes?
  updatedAt  DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, chunkIndex])
  @@index([pageId])
}

model PageVersion {
  id          String   @id @default(cuid())
  pageId      String
  title       String
  content     Json?
  textContent String   @default("")
  authorId    String?
  createdAt   DateTime @default(now())

  page   Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([pageId])
}

/// Tokenbasierte E-Mail-Einladung in einen Space.
/// Sicherheit: es wird nur der SHA-256-Hash des Tokens gespeichert,
/// nie das Token selbst (analog zu Passwort-Reset-Tokens).
model SpaceInvitation {
  id          String    @id @default(cuid())
  spaceId     String
  email       String
  role        SpaceRole @default(MEMBER)
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  /// Höchstens eine offene Einladung pro E-Mail/Space.
  @@unique([spaceId, email])
  @@index([spaceId])
}

/// Seitenvorlage eines Space: Startinhalt (TipTap-JSON) für neue Seiten.
/// Eingebaute Vorlagen (Meeting, ADR, …) liegen im Code, nicht hier.
model PageTemplate {
  id          String   @id @default(cuid())
  spaceId     String
  name        String
  description String?
  icon        String?
  content     Json?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  space     Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([spaceId])
}

/// Von Hocuspocus verwalteter Yjs-Dokumentstatus
model CollabDocument {
  pageId    String   @id
  state     Bytes
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}
