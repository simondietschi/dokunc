generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum SpaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  /// Instanz-Admin (die erste registrierte Person).
  isAdmin      Boolean  @default(false)
  /// Deaktivierte Konten können sich nicht anmelden.
  isActive     Boolean  @default(true)
  /// Wird bei "überall abmelden" / Passwortwechsel erhöht -> alte JWTs ungültig.
  tokenVersion Int      @default(0)
  /// E-Mail bei Erwaehnungen und Kommentaren (jeweils abschaltbar).
  emailOnMention Boolean @default(true)
  emailOnComment Boolean @default(true)
  /// TOTP-Geheimnis, verschluesselt (siehe lib/secret-box).
  totpSecret     String?
  /// Gesetzt, sobald die Einrichtung mit einem gueltigen Code bestaetigt wurde.
  totpEnabledAt  DateTime?
  /// Zuletzt akzeptierter TOTP-Zeitschritt. Verhindert, dass derselbe
  /// Code innerhalb seines Fensters ein zweites Mal gilt (RFC 6238, 5.2).
  totpLastStep   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   SpaceMember[]
  pageVersions  PageVersion[]
  passwordResets PasswordResetToken[]
  comments      Comment[]
  notifications Notification[] @relation("NotificationUser")
  actedNotifications Notification[] @relation("NotificationActor")
  uploads       Upload[]
  auditEvents   AuditLog[]     @relation("AuditActor")
  sessions      Session[]
  pageSubscriptions PageSubscription[]
  favorites     PageFavorite[]
  visits        PageVisit[]
  recoveryCodes TotpRecoveryCode[]
}

/// Angemeldetes Geraet. Das JWT im Cookie traegt die Session-ID; damit
/// laesst sich eine einzelne Anmeldung beenden, ohne alle anderen
/// mitzureissen (dafuer gibt es weiterhin tokenVersion).
model Session {
  id         String    @id @default(cuid())
  userId     String
  /// Roher User-Agent, nur zur Wiedererkennung in der Uebersicht.
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  /// Grob nachgefuehrt (hoechstens alle paar Minuten), nicht pro Anfrage.
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

/// Tokenbasierter Passwort-Reset (nur SHA-256-Hash gespeichert).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum SpaceVisibility {
  /// Nur mit Einladung sichtbar und betretbar.
  PRIVATE
  /// Fuer alle angemeldeten Personen auffindbar und beitretbar.
  OPEN
}

model Space {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String?
  visibility  SpaceVisibility @default(PRIVATE)
  /// Rolle, die ein Beitritt ueber die Space-Uebersicht vergibt.
  joinRole    SpaceRole       @default(MEMBER)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  members SpaceMember[]
  pages   Page[]
  invitations SpaceInvitation[]
  uploads Upload[]
  auditEvents AuditLog[]
}

model SpaceMember {
  id      String    @id @default(cuid())
  userId  String
  spaceId String
  role    SpaceRole @default(MEMBER)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@index([spaceId])
}

model Page {
  id          String   @id @default(cuid())
  spaceId     String
  parentId    String?
  title       String   @default("Untitled")
  /// Emoji vor dem Titel (Seitenbaum, Suche, Palette).
  icon        String?
  /// Titelbild ueber der Seite (URL aus /api/files).
  coverUrl    String?
  /// Vorlage: taucht beim Anlegen neuer Seiten zur Auswahl auf.
  isTemplate  Boolean  @default(false)
  /// TipTap/ProseMirror JSON
  content     Json?
  /// Flacher Text für Suche & History
  textContent String   @default("")
  position    Int      @default(0)
  /// Soft-Delete: gesetzt = im Papierkorb (nicht hart gelöscht).
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  space    Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parent   Page?          @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Page[]         @relation("PageTree")
  versions PageVersion[]
  collab   CollabDocument?
  outgoingLinks PageLink[] @relation("LinkSource")
  incomingLinks PageLink[] @relation("LinkTarget")
  comments      Comment[]
  chunks        PageChunk[]
  subscriptions PageSubscription[]
  favorites     PageFavorite[]
  visits        PageVisit[]
  shares        PageShare[]

  @@index([spaceId])
  @@index([parentId])
  @@index([spaceId, isTemplate])
}

/// Wiki-Link zwischen zwei Seiten ([[Seite]]) — Basis für Backlinks.
/// Wird vom Collab-Server aus dem Dokumentinhalt extrahiert.
model PageLink {
  id           String @id @default(cuid())
  sourcePageId String
  targetPageId String

  source Page @relation("LinkSource", fields: [sourcePageId], references: [id], onDelete: Cascade)
  target Page @relation("LinkTarget", fields: [targetPageId], references: [id], onDelete: Cascade)

  @@unique([sourcePageId, targetPageId])
  @@index([targetPageId])
}

/// Kommentar-Thread auf einer Seite. parentId = Antwort im Thread.
/// anchorText = Textstelle, auf die sich der Thread bezieht (Snapshot);
/// die Markierung im Dokument trägt die Thread-ID als commentMark.
model Comment {
  id         String    @id @default(cuid())
  pageId     String
  parentId   String?
  authorId   String?
  body       String
  anchorText String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  page    Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("Thread")
  author  User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([parentId])
}

enum NotificationType {
  MENTION
  COMMENT
  COMMENT_REPLY
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  pageId    String?
  commentId String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User  @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
}

/// Text-Chunk einer Seite für die KI-Suche ("Frag dein Wiki").
/// embedding: Float32-Vektor (Bytes) — optional, nur mit Embedding-Key.
model PageChunk {
  id         String   @id @default(cuid())
  pageId     String
  chunkIndex Int
  text       String
  embedding  Bytes?
  updatedAt  DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, chunkIndex])
  @@index([pageId])
}

model PageVersion {
  id          String   @id @default(cuid())
  pageId      String
  title       String
  content     Json?
  textContent String   @default("")
  authorId    String?
  createdAt   DateTime @default(now())

  page   Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([pageId])
}

/// Tokenbasierte E-Mail-Einladung in einen Space.
/// Sicherheit: es wird nur der SHA-256-Hash des Tokens gespeichert,
/// nie das Token selbst (analog zu Passwort-Reset-Tokens).
model SpaceInvitation {
  id          String    @id @default(cuid())
  spaceId     String
  email       String
  role        SpaceRole @default(MEMBER)
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  /// Höchstens eine offene Einladung pro E-Mail/Space.
  @@unique([spaceId, email])
  @@index([spaceId])
}

/// Von Hocuspocus verwalteter Yjs-Dokumentstatus
model CollabDocument {
  pageId    String   @id
  state     Bytes
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

/// Hochgeladene Datei. Der Space-Bezug ist die Grundlage der
/// Zugriffskontrolle in /api/files/[name]: ohne ihn waere jedes
/// hochgeladene Bild fuer jede angemeldete Person lesbar.
enum UploadKind {
  IMAGE
  FILE
}

model Upload {
  id          String     @id @default(cuid())
  /// Zufaelliger Dateiname auf der Platte, zugleich das URL-Segment.
  filename    String     @unique
  /// Name, unter dem die Datei hochgeladen wurde (nur zur Anzeige).
  originalName String    @default("")
  /// Bilder werden inline ausgeliefert, alles andere als Download.
  kind        UploadKind @default(IMAGE)
  spaceId     String
  uploaderId  String?
  contentType String
  size        Int
  createdAt   DateTime   @default(now())

  space    Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  uploader User? @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([spaceId])
  @@index([uploaderId])
}

/// Sicherheitsrelevante Ereignisse. Bewusst nur anhaengend: es gibt
/// keine Aktion in der App, die Eintraege aendert oder loescht.
model AuditLog {
  id        String   @id @default(cuid())
  /// Handelnde Person. Null, wenn unbekannt (fehlgeschlagene Anmeldung).
  actorId   String?
  /// Stabiler Ereignisschluessel, z. B. "member.role_changed".
  action    String
  spaceId   String?
  /// Kennung des betroffenen Objekts (Seite, Nutzer, Einladung).
  targetId  String?
  /// Zusatzkontext (alte und neue Rolle, Titel, Grund).
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  actor User?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  space Space? @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([spaceId, createdAt])
  @@index([actorId, createdAt])
}

/// Jemand folgt einer Seite und wird ueber Kommentare informiert,
/// auch ohne selbst schon mitgeschrieben zu haben.
model PageSubscription {
  id        String   @id @default(cuid())
  userId    String
  pageId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([userId, pageId])
  @@index([pageId])
}

/// Persoenliches Lesezeichen auf eine Seite.
model PageFavorite {
  id        String   @id @default(cuid())
  userId    String
  pageId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([userId, pageId])
  @@index([userId, createdAt])
}

/// Zuletzt besuchte Seiten, pro Person eine Zeile je Seite.
model PageVisit {
  userId    String
  pageId    String
  visitedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([userId, pageId])
  @@index([userId, visitedAt])
}

/// Freigabelink auf eine Seite: Lesen ohne Konto.
/// Wie bei Einladungen wird nur der SHA-256-Hash des Tokens gespeichert.
model PageShare {
  id            String    @id @default(cuid())
  pageId        String
  tokenHash     String    @unique
  createdById   String?
  /// Untergeordnete Seiten mitfreigeben.
  includeChildren Boolean @default(false)
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

/// Wiederherstellungscode fuer die Zwei-Faktor-Anmeldung.
/// Gespeichert wird nur der SHA-256-Hash, wie bei Einladungen.
model TotpRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
}
